{
  "name": "NQ",
  "short_name": "NQ",
  "description": "OLYMPUS NQ: the NQ bots right now: PC status, live trades, chart, accounts, order flow, brain. Opens straight into NQ.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "standalone"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "categories": [
    "finance",
    "productivity"
  ],
  "shortcuts": [
    {
      "name": "Live",
      "short_name": "Live",
      "description": "Trades, accounts and setups right now",
      "url": "./live.html",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Accounts",
      "short_name": "Accounts",
      "description": "Room to max loss, to pass, payouts",
      "url": "./accounts.html",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Brain",
      "short_name": "Brain",
      "description": "What each bot is doing and why",
      "url": "./brain.html",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
